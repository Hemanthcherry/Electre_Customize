<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false">

	
	<targets>
		
		<target name="logfile" xsi:type="File"
				fileName="D:\Electre\electre_customize\system\Logs\${shortdate}.log"
				layout="${longdate}|${uppercase:${level}}|${message}"
				archiveAboveSize="10485760" 
		archiveFileName="D:\Electre\electre_customize\system\Logs\logs\archived\${shortdate}.{#}.log"
		archiveNumbering="Rolling"
		maxArchiveFiles="7"
		concurrentWrites="true"
		keepFileOpen="false" />

		<!-- Console target for debugging purposes during development -->
		<target name="logconsole" xsi:type="Console"
				layout="${longdate} ${uppercase:${level}} ${message}" />
	</targets>

	<!-- Rules to map from logger name to target -->
	<rules>
		<!-- Log all levels to both file and console -->
		<logger name="*" minlevel="Info" writeTo="logfile,logconsole" />
	</rules>
</nlog>
