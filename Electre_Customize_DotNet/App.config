<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!--Performance diagnostics: off by default. Set to "true" to enable Stopwatch timing logs and,
		    combined with PerfFingerprint below, deterministic output fingerprint capture for
		    pre/post optimization comparison. Never enable in normal production use.-->
		<add key="PerfDiagnostics" value="false" />
		<add key="PerfFingerprint" value="false" />
		<!--Cable List / Continuity: "false" (default) copies every numbered sheet from the template workbook, as before.
		    "true" copies only the first sheet from the template and the rest from that first copy inside the report
		    workbook (much faster with many sheets). Compare the output (fingerprint) before relying on it.-->
		<add key="IntraWorkbookSheetCopy" value="false" />
		<!--Sheet-wise and component-wise wire-list reports: "false" (default) = original sequence (SaveAs, re-Open, Saves, Close).
		    "true" builds each workbook in one pass with a single SaveAs (same header/data/format/Excel sort). Compare output first.-->
		<add key="OnePassWirelistWorkbook" value="false" />
		<!--Loom (with and without template) and sheet-wise wire-list reports: every loom/sheet is an independent workbook.
		    "1" (default) = one Excel instance, one after the other, exactly as before. "2".."8" = that many Excel processes work
		    through the looms/sheets at the same time (each needs its own memory; 2-4 is sensible). Compare output first.-->
		<add key="ExcelWorkerCount" value="1" />
		<!--Cable List / Continuity: .xls holds at most 255 sheets; a report that needs more fails outright with no
		    file produced. "true" (default) saves as .xlsx instead ONLY above that threshold - below it, behaviour is
		    unchanged. "false" keeps the old all-or-nothing .xls behaviour (report fails above the limit).-->
		<add key="AutoXlsxAboveSheetLimit" value="true" />
		<add key="DataExtraction" value="schema\data_extraction.csv" />
		<add key="TempFolder" value="templ\TempFiles\" />
		<add key="ReportFolder" value="templ\" />
		<add key="LibrayPath" value="\LCA_TABLE_CONTACT_xl_04Apr24.csv"/>
		
		<!--wireList folder-->
		<add key="SheetFolder" value="SheetWireListReports\" />
		<add key="LoomFolder" value="LoomWireListReports\" />
		<add key="WireListFolder" value="WireListReports\" />
		<add key="BundleFolder" value="BundleReports\" />
		<!--Megger Folder-->
		<add key="MeggerSchedulerFolder" value="MeggerSchedulerReports\"/>
		
		<!--continuity Folder-->
		<add key="ContinuityFolder" value="Continuity_WO_Breakdown\" />
		<add key="ContinuityCompFolder" value="ContinuityCompReports\" />
		<!--Component Breakdown Folders-->
		<add key="EquipmentFolder" value="EquipmentWireListReports\" />
		<add key="BrkFolder" value="BreakConnWireListReports\" />
		<add key="JmFolder" value="JunctionModWireListReports\" />
		<add key="MiscFolder" value="MiscWireListReports\" />

		<!--powerOn Folder-->
		<add key="PowerOnFolder" value ="PowerOnReports\"/>

		<!--Panel Drawing Folder-->
		<add key="PanelDrawingFolder" value ="TempFiles\"/>

		<!--Panel Drawing Schedules Folder-->
		<add key="LoomFolderCL" value="PanelSchedules\LoomWireListReports_Panel\" />
		<add key="LoomFolderBundleCL" value="PanelSchedules\BundleReports_Panel\" />
		<add key="SheetFolderCL" value="PanelSchedules\SheetWireListReports_Panel\" />
		<add key="panelContinuityFolder" value="PanelSchedules\Continuity_WO_Breakdown_Panel\" />
		<add key="panelContinuityCompFolder" value="PanelSchedules\ContinuityCompReports_Panel\" />
		<add key="panelMeggerFolder" value="PanelSchedules\MeggerReports_Panel\" />
		<add key="panelPowerOnFolder" value="PanelSchedules\PowerOnReports_Panel\" />
		
		
		
		<!--Report type Name-->
		<add key="cableListTitle" value="Cable List Report" />
		<add key="componetBreakTitle" value="Component Specific Breakdown Report" />
		<add key="continuityTitle" value="Continuity Without Breakdown Report" />
		<add key="MeggerTitle" value="Megger Scheduler Report"/>
		<add key="powerOnTitle" value="Power On Schedule"/>
		<add key="panelDrawingTitle" value="Panel Drawing"/>
		<add key="panelDwgSchedulesTitle" value="Panel Dwg Schedules"/>
	</appSettings>
</configuration>